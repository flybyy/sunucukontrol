PANEL_USERNAME=admin
PANEL_PASSWORD_HASH=REPLACE_WITH_ARGON2_HASH
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
PANEL_ORIGIN=http://localhost:9090
PANEL_SECURE_COOKIES=false
PANEL_PORT=9090
PANEL_DATA_DIR=/data
PANEL_AUDIT_DIR=/data/audit
PANEL_UPLOAD_MAX_MB=512
PANEL_SESSION_HOURS=8
PANEL_REQUIRE_CF_ACCESS=false
PANEL_ALLOWED_CF_EMAILS=
MINECRAFT_PUBLIC_HOST=
ALERT_CPU_PERCENT=90
ALERT_RAM_PERCENT=90
ALERT_DISK_PERCENT=85
ALERT_TEMP_C=80
ALERT_COOLDOWN_MINUTES=30
BACKUP_OFFSITE_DIR=
BACKUP_RCLONE_REMOTE=
RCLONE_CONFIG=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NOTIFY_WEBHOOK_URL=
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_TUNNEL_ID=

# v3 configuration
PANEL_ENV=production
PANEL_CONTAINER_MODE=true
PANEL_DOCKER_ENABLED=true
PANEL_PUBLIC_ORIGINS=
PANEL_TRUST_CF_HEADERS=false

# Optional TOTP: python -c "import pyotp; print(pyotp.random_base32())"
PANEL_TOTP_SECRET=
PANEL_SSH_KEY=/run/secrets/fleet_ssh_key
PANEL_SSH_KNOWN_HOSTS=/run/secrets/fleet_known_hosts
